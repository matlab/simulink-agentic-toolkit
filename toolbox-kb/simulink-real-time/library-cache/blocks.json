    {
      "name": "File Log",
      "referenceBlock": "slrealtimeloglib/File Log",
      "blockType": "SubSystem",
      "description": "",
      "category": "",
      "maskType": "slrealtimeloggingblock",
      "maskDescription": "Log signal to file on the target computer.\n\nWhile the logging service is enabled, the block logs the input signal to the target computer file system. The logging service is enabled by default for a model containing this block.\n\nAfter the simulation run ends, the target computer uploads the File Log data to the Simulation Data Inspector on the development computer. If the target computer is not connected to the development computer, you can upload the file log data when the computers are connected.",
      "pathCategory": "Logging",
      "metadataQuality": "high",
      "introducedIn": "2024a"
    },
    {
      "name": "Steering Wheel Read",
      "referenceBlock": "slrealtimeG29lib/Steering Wheel Read",
      "blockType": "S-Function",
      "description": "",
      "category": "",
      "maskType": "Logitech G29 Steering Wheel",
      "maskDescription": "Block to read data from Logitech G29 Steering Wheel (PS3 only).\n Block does not support Stick Shift module.\n OUTPUT PORTS:\n BUTTONS: Vector of booleans that reflect status of buttons on steering wheel.\n \t1 = pressed, 0 = unpressed.\n \tOrder: 1: Square, 2: X, 3: Circle,\n \t4: Triangle, 5: LPaddle, 6: RPaddle,\n \t7: L2, 8: R2, 9: L3, 10: R3,\n \t11: Share, 12: Option, 13: PS\n STEERING: uint16 type value for position of steering wheel. 0: left most, 65535: right most.\n PEDALS: uint8 vector of length 3, throttle, brake, and clutch.\n DIRECTION: uint8 output of directional pad on the steering wheel.\n \tUNPRESSED: 8\n \tUP: 0\n \tRIGHT: 2\n \tDOWN: 4\n \tLEFT: 6\n \tIntermediate values when pressed in between.\n STATUS: int32 type indicates status of communication with steering wheel.\n \tDefault value: 0\n \tError state value: less than 0",
      "pathCategory": "Logitech G29",
      "metadataQuality": "high",
      "introducedIn": "2024a"
    },
